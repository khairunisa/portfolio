---

{brand[name] ? (
  <svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="currentColor">
    <path d={brand[name]} />
  </svg>
) : (
  <svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {name === 'email' && (
      <>
        <rect x="2.5" y="5" width="19" height="14" rx="2" />
        <path d="m3 6.5 9 6.5 9-6.5" />
      </>
    )}
    {name === 'globe' && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
      </>
    )}
    {name === 'video' && (
      <>
        <rect x="3" y="6" width="13" height="12" rx="2" />
        <path d="M16 10l5-3v10l-5-3z" />
      </>
    )}
  </svg>
)}

<style>
  .icon {
    flex: none;
    display: block;
  }
</style>
