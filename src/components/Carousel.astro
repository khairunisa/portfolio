---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Accessible name for the carousel, usually the project title. */
  label: string;
  /** Sizes hint for responsive images. */
  sizes?: string;
  /** Load the first image eagerly (use for above-the-fold carousels). */
  eager?: boolean;
}

const { images, label, sizes = '(min-width: 900px) 33vw, 100vw', eager = false } = Astro.props;

// Full-size versions for the lightbox.
const full = await Promise.all(
  images.map((img) => getImage({ src: img.src, width: Math.min(img.src.width, 1920), format: 'webp' })),
);
const many = images.length > 1;
---

<div class="carousel" data-carousel aria-roledescription="carousel" aria-label={`${label} screenshots`}>
  <div class="track" tabindex={many ? 0 : undefined} data-track>
    {
      images.map((img, i) => (
        <figure
          class="slide"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${images.length}`}
          data-slide
        >
          <button
            type="button"
            class="zoom"
            data-full={full[i].src}
            data-alt={img.alt}
            aria-label={`View ${img.alt || `screenshot ${i + 1}`} full size`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[480, 800, 1200]}
              sizes={sizes}
              format="webp"
              loading={eager && i === 0 ? 'eager' : 'lazy'}
              draggable="false"
            />
          </button>
        </figure>
      ))
    }
  </div>

  {
    many && (
      <>
        <button type="button" class="nav nav--prev" data-prev aria-label="Previous screenshot">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="nav nav--next" data-next aria-label="Next screenshot">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
        <div class="dots" data-dots>
          {images.map((_, i) => (
            <button
              type="button"
              class="dot"
              data-dot={i}
              aria-label={`Show screenshot ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
            />
          ))}
        </div>
      </>
    )
  }
</div>

<style>
  .carousel {
    position: relative;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--stage);
  }

  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline-offset: -3px;
  }

  .slide {
    flex: 0 0 100%;
    margin: 0;
    scroll-snap-align: start;
    aspect-ratio: 16 / 9;
  }

  .zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .zoom:focus-visible {
    outline-offset: -4px;
    border-radius: var(--radius-media);
  }

  /* contain = portrait phone screenshots letterbox instead of being cropped */
  .zoom :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
  }

  .nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: rgb(14 19 27 / 0.8);
    color: #fff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .nav svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nav--prev {
    left: 0.6rem;
  }
  .nav--next {
    right: 0.6rem;
  }
  .nav:disabled {
    visibility: hidden;
  }
  .carousel:hover .nav,
  .carousel:focus-within .nav {
    opacity: 1;
  }
  /* Touch screens: no hover, so keep arrows visible but rely on swipe too. */
  @media (hover: none) {
    .nav {
      opacity: 1;
      width: 2.1rem;
      height: 2.1rem;
    }
  }

  .dots {
    position: absolute;
    bottom: 0.6rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-control);
    background: rgb(14 19 27 / 0.6);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition: width 0.2s, background-color 0.2s;
  }
  .dot[aria-current='true'] {
    width: 1.25rem;
    background: #fff;
  }
</style>

<script>
  function setup(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (slides.length < 2) return;

    let index = 0;

    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[target].offsetLeft });
    };

    const update = (i: number) => {
      index = i;
      dots.forEach((d, n) => d.setAttribute('aria-current', String(n === i)));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) update(slides.indexOf(e.target as HTMLElement));
        }
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    prev?.addEventListener('click', () => goTo(index - 1));
    next?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((d, n) => d.addEventListener('click', () => goTo(n)));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        goTo(index - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        goTo(index + 1);
      }
    });
    update(0);
  }

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setup);
</script>
