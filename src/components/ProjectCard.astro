---
import Carousel from './Carousel.astro';
import StoreLinks from './StoreLinks.astro';
import { gallery, statusLabel, type Project } from '../lib/projects';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data } = project;
const hasWriteUp = Boolean(project.body?.trim());
const detailUrl = `/projects/${project.id}/`;
---

<article class:list={['project', { 'project--featured': featured }]} data-status={data.status}>
  <Carousel
    images={gallery(project)}
    label={data.title}
    eager={featured}
    sizes={featured ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 1100px) 380px, (min-width: 700px) 50vw, 100vw'}
  />
  <div class="body">
    <p class={`status status--${data.status}`}>{statusLabel(project)}</p>
    <h3>
      {hasWriteUp ? <a href={detailUrl}>{data.title}</a> : data.title}
    </h3>
    <p class="role">{data.role}</p>
    <p class="summary">{data.summary}</p>
    {data.tags.length > 0 && (
      <ul class="tags" aria-label="Built with">
        {data.tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
    <StoreLinks links={data.links} title={data.title} />
    {hasWriteUp && (
      <a class="more" href={detailUrl}>
        Read how it was made<span class="visually-hidden">: {data.title}</span>
      </a>
    )}
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .status,
  .role,
  .summary {
    margin: 0;
  }

  h3 {
    font-size: var(--step-2);
    font-stretch: 88%;
  }
  h3 a {
    color: inherit;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }

  .role {
    color: var(--muted);
    font-size: var(--step--1);
    margin-top: -0.3rem;
  }

  .summary {
    max-width: 60ch;
  }

  .tags {
    margin-top: 0.1rem;
  }

  .body :global(.store-links) {
    margin-top: 0.4rem;
  }

  .more {
    font-size: var(--step--1);
    font-weight: 700;
  }

  /* Featured: wide, image left, text right */
  @media (min-width: 900px) {
    .project--featured {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: clamp(1.5rem, 3vw, 3rem);
      align-items: center;
    }
    .project--featured h3 {
      font-size: var(--step-3);
    }
    .project--featured .summary {
      font-size: var(--step-1);
      line-height: 1.45;
    }
  }

  .project[hidden] {
    display: none;
  }
</style>
